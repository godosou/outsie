{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Repose main and local break windows",
  "windows": ["main", "break-*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "allow-set-status",
    "allow-set-preferences",
    "allow-get-lifecycle-snapshot",
    "allow-acknowledge-lifecycle-interval",
    "allow-postpone-break",
    "allow-notify-user",
    "allow-open-security-settings"
  ]
}
